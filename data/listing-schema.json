{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bristol accommodation listing v2",
  "type": "object",
  "required": [
    "id",
    "name",
    "provider",
    "source_url",
    "academic_year",
    "booking_status",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "academic_year": {
      "type": "string",
      "pattern": "^20[0-9]{2}/[0-9]{2}$"
    },
    "booking_status": {
      "enum": [
        "open",
        "rebooking_only",
        "register_interest",
        "not_released",
        "sold_out",
        "unknown"
      ]
    },
    "from_price_gbp_per_week": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 1999
    },
    "price_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "offer": {
      "type": [
        "string",
        "null"
      ]
    },
    "offer_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "verification_method": {
      "enum": [
        "operator_page",
        "operator_api",
        "manual"
      ]
    },
    "verification_notes": {
      "type": "string"
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
